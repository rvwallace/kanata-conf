;; =============================================================================
;; Ultimate Kanata Layout for MacBook & NuPhy Air75
;; Repo: ~/silentcastle/projects/kanata-conf
;; =============================================================================

(defcfg
  ;; Process unmapped keys so normal typing remains unaffected
  process-unmapped-keys yes
)

;; -----------------------------------------------------------------------------
;; 1. Variables & Timing (Centralized for easy tuning)
;; -----------------------------------------------------------------------------
(defvar
  tap-time        180
  hold-time       200
  space-hold-time 230
)

;; -----------------------------------------------------------------------------
;; 2. Source Keys (Physical layout to intercept)
;; -----------------------------------------------------------------------------
(defsrc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lalt lmet           spc            rmet ralt
)

;; -----------------------------------------------------------------------------
;; 3. Aliases
;; -----------------------------------------------------------------------------
(defalias
  ;; Caps Lock: Tap for Esc, Double-Tap for CapsLock, Hold for Nav Layer
  caps-dance (tap-dance 200 (esc caps))
  caps-nav   (tap-hold $tap-time $hold-time @caps-dance (layer-while-held nav))

  ;; Tab: Tap for Tab, Hold for Hyper (Cmd + Option + Ctrl + Shift)
  tab-hyper  (tap-hold $tap-time $hold-time tab (multi lmet lalt lctl lsft))

  ;; Space: Tap for Space, Hold for Numpad/Symbols Layer
  space-num  (tap-hold-release $space-hold-time $space-hold-time spc (layer-while-held num))

  ;; Symbol Aliases
  excl S-1
  at   S-2
  hash S-3
  dllr S-4
  prct S-5
  crt  S-6
  amp  S-7
  astr S-8
  lprn S-9
  rprn S-0
  plus S-=
  tild S-grv
  pipe S-\
)

;; -----------------------------------------------------------------------------
;; 4. Base Layer (Default typing layer)
;; -----------------------------------------------------------------------------
(deflayer base
  grv        1    2    3    4    5    6    7    8    9    0    -    =    bspc
  @tab-hyper q    w    e    r    t    y    u    i    o    p    [    ]    \
  @caps-nav  a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft       z    x    c    v    b    n    m    ,    .    /    rsft
  lctl       lalt lmet          @space-num       rmet ralt
)

;; -----------------------------------------------------------------------------
;; 5. Navigation & Editing Layer (Active while holding Caps Lock)
;; -----------------------------------------------------------------------------
;; - HJKL: Arrow keys
;; - UIOP: Home, PgDn, PgUp, End
;; - ASDF: Left-hand modifiers (Ctrl, Option, Cmd, Shift) optimized for Mac navigation
;; - ZXCV: macOS Editing shortcuts (Undo, Cut, Copy, Paste)
;; - Backspace: Forward Delete
(deflayer nav
  _     _    _    _    _    _    _    _    _    _    _    _    _    del
  _     _    _    _    _    _    _    home pgdn pgup end  _    _    _
  _     lctl lalt lmet lsft _    left down up   rght _    _    _
  _     M-z  M-x  M-c  M-v  _    _    _    _    _    _    _
  _     _    _              _              _    _
)

;; -----------------------------------------------------------------------------
;; 6. Numpad & Symbols Layer (Active while holding Space)
;; -----------------------------------------------------------------------------
(deflayer num
  _     _      _    _     _     _     _    _    _    _    _     _    _    _
  _     @excl  @at  @hash @dllr @prct _    7    8    9    @plus -    _    _
  _     @crt   @amp @astr @lprn @rprn _    4    5    6    @astr /    =
  _     @tild  grv  [     ]     @pipe 0    1    2    3    .     _
  _     _      _                _               _    _
)
